      "id": "sa5-pe-minem-rules",
      "name": "MINEM · 法律文件",
      "kind": "web_list",
      "lane": "policy",
      "config": {
        "url": "https://www.gob.pe/institucion/minem/normas-legales",
        "itemSelector": "ul.js-rules-search-results > li",
        "linkSelector": "a.card__mock",
        "titleSelector": "a.card__mock",
        "language": "es",
        "allowUrlPrefixes": [
          "https://www.gob.pe/institucion/minem/normas-legales/"
        ],
        "detail": {
          "maxFetches": 5
        },
        "sourceDate": {
          "format": "iso8601",
          "language": "es"
        },
        "publishedAtRegex": "<time[^>]*datetime=\"(\\d{4}-\\d{2}-\\d{2})"
      },
      "tier": "T1",
      "first_party": true,
      "owner_entity_id": null,
      "participation_mode": "editorial",
      "interval_minutes": 360,
      "tags": [],
      "site_fulltext": false,
      "syndicate_fulltext": false,
