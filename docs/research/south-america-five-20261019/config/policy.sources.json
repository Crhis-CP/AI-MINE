    {
      "id": "sa5-ar-hcdn-bills",
      "name": "阿根廷众议院矿业委员会—议案",
      "kind": "web_list",
      "lane": "policy",
      "config": {
        "url": "https://www.hcdn.gob.ar/comisiones/permanentes/cmineria/listado-proyectos.html",
        "language": "es",
        "itemSelector": "table tbody tr",
        "linkSelector": "td[headers=\"expHead\"] a",
        "titleSelector": "td[headers=\"sumHead\"]",
        "publishedAtSelector": "td[headers=\"fechaHead\"]",
        "allowUrlPrefixes": [
          "https://www.hcdn.gob.ar/comisiones/permanentes/cmineria/proyecto.html"
        ],
        "sourceDate": {
          "format": "declared",
          "formatPattern": "DD/MM/YYYY",
          "language": "es",
          "meaning": "event",
          "publicationBasis": "other",
          "basis": "HCDN project table labels the field Fecha; preserve as project date without claiming source publication, filing, enactment or effectiveness"
        },
        "detail": {
          "maxFetches": 5
        }
      },
      "tier": "T1",
      "first_party": true,
      "owner_entity_id": null,
