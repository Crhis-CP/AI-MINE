    {
      "id": "sa5-ar-arca-biblioteca",
      "name": "阿根廷税务与海关管理局 ARCA—法规库",
      "kind": "web_list",
      "lane": "policy",
      "config": {
        "url": "https://biblioteca.arca.gob.ar/search/query/ajax.GetNovedadesRG.aspx",
        "itemSelector": "div.cn_item",
        "linkSelector": "a[href*=\"norma.aspx\"]",
        "titleSelector": "p",
        "publishedAtRegex": "\\|f:(\\d{2}/\\d{2}/\\d{4})",
        "sourceDate": {
          "format": "declared",
          "formatPattern": "DD/MM/YYYY",
          "language": "es",
          "meaning": "signed",
          "publicationBasis": "other",
          "basis": "Repository AR-004 notes identify the list date as the resolution signing/issuance date, not its publication in the official gazette; live response is empty, so this remains a candidate."
        },
        "allowUrlPrefixes": [
          "https://biblioteca.arca.gob.ar/search/query/norma.aspx"
        ],
        "language": "es"
      },
      "tier": "T1",
      "first_party": true,
      "owner_entity_id": null,
      "participation_mode": "editorial",
      "interval_minutes": 360,
