    {
      "id": "sa5-co-anm-rules",
      "name": "哥伦比亚国家矿业局 ANM · 决议",
      "kind": "json_list",
      "lane": "policy",
      "config": {
        "url": "https://www.anm.gov.co/jsonapi/node/resoluciones?sort=-created&page%5Blimit%5D=3",
        "itemsPath": "data",
        "titlePaths": [
          "attributes.title"
        ],
        "summaryPaths": [
          "attributes.field_descripcion.0"
        ],
        "publishedAtPath": "attributes.field_fecha_de_publicacion",
        "externalIdPath": "attributes.drupal_internal__nid",
        "urlTemplate": "https://www.anm.gov.co/node/{attributes.drupal_internal__nid}",
        "sourceDate": {
          "format": "iso8601",
          "language": "es"
        },
        "language": "es",
        "requireBoolean": {
          "path": "attributes.status",
          "equals": true
        },
        "allowUrlPrefixes": [
          "https://www.anm.gov.co/node/"
        ],
        "detail": {
          "maxFetches": 5
