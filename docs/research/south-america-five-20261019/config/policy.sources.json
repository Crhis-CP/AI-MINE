    {
      "id": "sa5-gy-gazette-pubs",
      "name": "圭亚那官方电子公报",
      "kind": "json_list",
      "lane": "policy",
      "config": {
        "url": "https://officialegazette.gov.gy/api/publications?page=1&pageSize=50",
        "itemsPath": "publications",
        "titlePaths": [
          "title",
          "properties.cm:title",
          "name"
        ],
        "publishedAtPath": "publishedAt",
        "externalIdPath": "id",
        "urlTemplate": "https://officialegazette.gov.gy/publications/{id}",
        "language": "en",
        "sourceDate": {
          "format": "iso8601",
          "language": "en",
          "meaning": "site_public",
          "publicationBasis": "other",
          "basis": "API field publishedAt is the website publication timestamp. Captured sample publishedAt is 2026-10-16 while its gazette title is 12 September 2026; gazette issue and effective dates require separate document extraction."
        }
      },
      "tier": "T1",
      "first_party": true,
      "owner_entity_id": null,
      "participation_mode": "editorial",
      "interval_minutes": 360,
      "tags": [],
      "site_fulltext": false,
      "syndicate_fulltext": false,
      "enabled": false
    },
    {
      "id": "sa5-ar-boletin",
      "name": "阿根廷国家官方公报—第一部分",
      "kind": "web_list",
      "lane": "policy",
      "config": {
        "url": "https://www.boletinoficial.gob.ar/seccion/primera",
        "titleSelector": "div.linea-aviso",
        "publishedAtRegex": "/detalleAviso/primera/\\d+/(\\d{8})",
        "sourceDate": {
          "format": "declared",
          "formatPattern": "YYYYMMDD",
          "language": "es",
          "meaning": "formally_published",
          "publicationBasis": "formally_published",
          "basis": "The eight-digit suffix is the issue date in the official Boletin Oficial Primera Seccion item URL; day precision only, not a signing or effective date."
        },
        "allowUrlPrefixes": [
          "https://www.boletinoficial.gob.ar/detalleAviso/primera/"
        ],
        "language": "es",
        "itemSelector": "#avisosSeccionDiv > div.row:not(div.row:has(h5.seccion-rubro:contains(\"CONCURSOS OFICIALES\")) ~ div.row):not(div.row:has(h5.seccion-rubro:contains(\"REMATES OFICIALES\")) ~ div.row):not(div.row:has(h5.seccion-rubro:contains(\"AVISOS OFICIALES\")) ~ div.row):not(div.row:has(h5.seccion-rubro:contains(\"CONVENCIONES COLECTIVAS\")) ~ div.row) a[href^=\"/detalleAviso/primera/\"]:has(div.linea-aviso)",
        "policyProfile": {
          "version": 1,
          "officialRole": {
            "kind": "official_original",
            "evidenceUrl": "https://www.boletinoficial.gob.ar/detalleAviso/primera/348786/20261009",
            "basis": "国家公报第一部分当日列表指向同一主机的单件页。2026-10-09 核对 Resolución 1433/2026：标题在 #tituloDetalleAviso，正文在 #cuerpoDetalleAviso，页面是 HTML。",
            "singleObjectPattern": "^https://www\\.boletinoficial\\.gob\\.ar/detalleAviso/primera/\\d+/\\d{8}$"
          },
          "identityMarker": {
            "selector": "#tituloDetalleAviso",
            "pattern": "^[\\s\\S]{12,800}$"
          },
          "titleSelector": "#tituloDetalleAviso",
          "numberSelector": null,
          "originalLinkSelector": null,
          "versionSelector": null,
          "identity": {
            "jurisdiction": {
              "value": "AR",
              "evidenceUrl": "https://www.boletinoficial.gob.ar/seccion/primera",
              "basis": "页面标题写明 BOLETIN OFICIAL REPUBLICA ARGENTINA，法域按登记为阿根廷。"
            },
            "authority": {
              "value": "阿根廷国家公报局",
              "evidenceUrl": "https://www.boletinoficial.gob.ar/seccion/primera",
              "basis": "第一部分目录由阿根廷国家公报发布，与登记发布方一致。"
            },
            "documentType": null
          },
          "language": "es",
          "kind": "original",
          "recheckMinutes": 360,
          "extraction": {
            "bodySelector": "#cuerpoDetalleAviso",
            "attachmentSelector": null,
            "maxBytes": 2097152,
            "maxResources": 5,
            "maxPages": 1,
            "maxTextBytes": 2097152
          }
        }
      },
      "tier": "T1",
      "first_party": true,
      "owner_entity_id": null,
      "participation_mode": "editorial",
      "interval_minutes": 360,
      "tags": [],
      "site_fulltext": false,
      "syndicate_fulltext": false,
      "enabled": false
    },
