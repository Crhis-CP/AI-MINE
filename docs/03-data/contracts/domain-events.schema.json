        "aggregate_version",
        "occurred_at",
        "correlation_id",
        "causation_id",
        "payload"
      ]
    }
  ],
  "$defs": {
    "RevisionReady": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "revision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policy_version": {
          "type": "integer",
          "minimum": 1
        },
        "lane": {
          "type": "string",
          "enum": [
            "news",
            "policy"
          ]
        }
      },
      "required": [
        "item_id",
        "revision_id",
        "content_hash",
        "policy_version",
        "lane"
      ]
    },
    "AnalysisReady": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "analysis_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "recipe_version": {
          "type": "string",
          "maxLength": 100
        },
        "publishability": {
          "type": "string",
          "enum": [
            "eligible",
            "guide_only",
            "withheld"
          ]
        }
      },
      "required": [
        "revision_id",
        "analysis_id",
        "recipe_version",
        "publishability"
      ]
    },
    "ReviewChanged": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subject_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "subject_revision": {
          "type": "integer",
          "minimum": 1
        },
        "decision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "suppressed": {
          "type": "boolean"
        }
      },
      "required": [
        "subject_id",
        "subject_revision",
        "decision_id",
        "suppressed"
      ]
    },
    "PublicationActivated": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "publication_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "policy_epoch": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "publication_id",
        "generation",
        "policy_epoch"
      ]
    },
    "SourceChanged": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "settings_version": {
          "type": "integer",
          "minimum": 1
        },
        "policy_version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "source_id",
        "settings_version",
        "policy_version"
      ]
    }
  }
}
