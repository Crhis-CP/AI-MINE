    "@amp/contracts": "workspace:*",
    "@amp/industry": "workspace:*",
    "@modelcontextprotocol/server": "2.1.0",
    "@resvg/resvg-js": "2.6.2",
    "fastify": "5.12.5",
    "satori": "0.33.5",
    "sharp": "0.35.5",
    "zod": "4.6.5",
    "fastify-type-provider-zod": "7.0.0",
    "@fastify/swagger": "9.9.1"
  }
}
