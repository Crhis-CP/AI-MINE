    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "@amp/api-client": "workspace:*"
  },
  "devDependencies": {
    "@react-router/dev": "8.4.0",
    "@tailwindcss/vite": "4.3.3",
