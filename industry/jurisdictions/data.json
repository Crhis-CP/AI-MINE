{
  "country_count_is_cap": false,
  "tier_definitions": {
    "existing18": "既有 18 国（旧站资讯线历史子集）：研究、取得、内容、持续运行四项都必达",
    "country_content": "10 国（秘鲁、俄罗斯、莫桑比克、津巴布韦、印度尼西亚、坦桑尼亚、委内瑞拉、厄瓜多尔、新加坡、乌兹别克斯坦）：范围依据有国别内容；四项都必达",
    "background": "5 国（英国、伊朗、瑞士、玻利维亚、马里）：范围依据只是背景提及、保留来源研究记录；留在研究（POL-R01～R07）分母内，首批取得/内容/持续运行验收排在其余 28 国和 3 个组织之后；不给背景提及加“发布法域”或新法标签（DEC-03；随 Q-09 答复沿用的默认做法，Owner 可改）",
    "organization": "欧盟、联合国、OECD：单列，不计入国家数；必达；条约或组织文书不等于成员国国内法",
    "subdivision": "下级法域（中国 14 个省区）：资讯线按原表 236 个目标接入；法规线的地方/部门来源只按发布职责纳入（BR-POL-25），不按行政区数量验收"
  },
  "scope_flags": {
    "news_scope": "资讯线范围：18 国 + 中国 14 个省区为 true；其余 false。资讯线 18 国起步、按实测逐步扩，不随法规线自动扩到 33 国（Owner 2026-10-01 已定，Q-09 已答复；DEC-03）",
    "policy_scope": "法规线范围：36 个对象全部为 true（阻断不移出分母）；下级法域为 false，其来源按发布职责纳入",
    "policy_first_batch_required": "首批取得/内容/持续运行验收是否必达；只有 background 层为 false"
  },
