{
  "name": "ai-mining-policy",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "dev:api": "npm run dev --workspace @amp/api",
    "dev:worker": "npm run dev --workspace @amp/worker",
    "dev:web": "npm run dev --workspace @amp/web",
    "typecheck": "tsc -p site && tsc -p packages/contracts && tsc -p packages/backend && tsc -p apps/api && tsc -p apps/worker && tsc -p tests && tsc -p scripts && tsc -p e2e && npm run typecheck --workspace @amp/web",
    "test": "node scripts/verify/test-files.ts",
    "check": "node scripts/verify/run.ts --quick",
    "dev:private-api": "npm run dev:private --workspace @amp/api",
    "contracts:gen": "node scripts/contracts/generate.ts",
    "contracts:check": "node scripts/contracts/generate.ts --check && node --test scripts/verify/contract-tests.ts",
    "check:data-ownership": "node scripts/verify/data-ownership.ts",
    "e2e": "npm run build --workspace @amp/web && npm run e2e:smoke",
    "e2e:smoke": "playwright test --config e2e/playwright.config.ts"
  },
  "dependencies": {
    "@amp/backend": "*",
    "@amp/industry": "*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@amp/contracts": "*",
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@modelcontextprotocol/client": "2.2.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/sanitize-html": "2.16.1",
    "fastify": "5.12.5",
    "opentype.js": "1.3.4",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "undici": "8.11.2",
    "yaml": "2.9.1",
    "@fastify/swagger": "9.9.1",
    "fastify-type-provider-zod": "7.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "industry",
    "site",
    "modules/*"
  ],
  "overrides": {
    "fflate": "0.7.5"
  }
}
