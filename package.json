{
  "name": "ai-mining-policy",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "dev:api": "pnpm --filter @amp/api dev",
    "dev:worker": "pnpm --filter @amp/worker dev",
    "dev:web": "pnpm --filter @amp/web dev",
    "typecheck": "tsc -p packages/platform/config && tsc -p packages/contracts && tsc -p packages/api-client && tsc -p packages/backend && tsc -p packages/ui && tsc -p apps/api && tsc -p apps/worker && tsc -p apps/fetcher && tsc -p tests && tsc -p scripts && tsc -p e2e && pnpm --filter @amp/web typecheck",
    "test": "node scripts/verify/test-files.ts",
    "check": "node scripts/verify/run.ts --quick",
    "dev:private-api": "pnpm --filter @amp/api dev:private",
    "contracts:gen": "pnpm --filter @amp/tooling generate",
    "contracts:check": "pnpm --filter @amp/tooling check && node --test scripts/verify/contract-tests.ts",
    "check:data-ownership": "node scripts/verify/data-ownership.ts",
    "e2e": "pnpm --filter @amp/web build && pnpm e2e:smoke",
    "e2e:smoke": "playwright test --config e2e/playwright.config.ts"
  },
  "dependencies": {
    "@amp/backend": "workspace:*",
    "@amp/industry": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@amp/config": "workspace:*",
    "@amp/contracts": "workspace:*",
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@modelcontextprotocol/client": "2.2.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/sanitize-html": "2.16.1",
    "fastify": "5.12.5",
    "opentype.js": "1.3.4",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "undici": "8.11.2",
    "yaml": "2.9.1"
  }
}
