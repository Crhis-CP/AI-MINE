{
  "name": "aihot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "dev:api": "pnpm --filter @aihot/api dev",
    "dev:worker": "pnpm --filter @aihot/worker dev",
    "dev:web": "pnpm --filter @aihot/web dev",
    "typecheck": "tsc -p packages/contracts && tsc -p packages/backend && tsc -p apps/api && tsc -p apps/worker && tsc -p tests && pnpm --filter @aihot/web typecheck",
    "test": "node --test --test-concurrency=1 --test-timeout=120000 \"tests/*.test.ts\""
  },
  "devDependencies": {
    "@aihot/backend": "workspace:*",
    "@aihot/contracts": "workspace:*",
    "@aihot/industry": "workspace:*",
    "@modelcontextprotocol/client": "2.1.0",
    "@types/node": "24.19.0",
    "@types/sanitize-html": "2.16.1",
    "@types/turndown": "5.0.6",
    "fastify": "5.12.5",
    "opentype.js": "1.3.4",
    "sharp": "0.35.4",
    "typescript": "7.0.2",
    "undici": "8.11.2",
    "zod": "4.6.5"
  }
}
