{
  "name": "ai-mining-policy",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "dev:api": "pnpm --filter @amp/api dev",
    "dev:worker": "pnpm --filter @amp/worker dev",
    "dev:web": "pnpm --filter @amp/web dev",
    "typecheck": "tsc -p packages/contracts && tsc -p packages/backend && tsc -p apps/api && tsc -p apps/worker && tsc -p tests && tsc -p scripts && pnpm --filter @amp/web typecheck",
    "test": "node --test --test-concurrency=1 --test-timeout=120000 \"tests/*.test.ts\"",
    "check": "node scripts/verify/run.ts --quick"
  },
  "dependencies": {
    "@amp/backend": "workspace:*",
    "@amp/industry": "workspace:*"
  },
  "devDependencies": {
    "@amp/contracts": "workspace:*",
    "@biomejs/biome": "2.5.15",
    "@modelcontextprotocol/client": "2.1.0",
    "@types/node": "24.19.0",
    "@types/sanitize-html": "2.16.1",
    "fastify": "5.12.5",
    "opentype.js": "1.3.4",
    "sharp": "0.35.4",
    "typescript": "7.0.2",
    "undici": "8.11.2",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  }
}
