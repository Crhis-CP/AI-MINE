{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@amp/web", "dev"],
      "port": 3000
    },
    {
      "name": "public-api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev:api"],
      "port": 3001
    },
    {
      "name": "private-api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev:private-api"],
      "port": 3002
    }
  ]
}
