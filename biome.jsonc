// Biome: the one formatter and linter (T-0001; docs/04-architecture/02-tech-stack.md 1.2, 7.1).
// lineWidth 160 was measured on the imported code: of 140 / 150 / 160 it rewraps the fewest lines.
{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    // The handoff documents, the upstream lock and the reference spec are kept byte for byte.
    "includes": ["**", "!docs", "!upstream", "!reference", "!pnpm-lock.yaml"]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 160 },
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always", "trailingCommas": "all" } },
  "css": { "parser": { "tailwindDirectives": true } },
  // Import sorting stays off while the imported code is restructured: reordering imports is not a pure format change.
  "assist": { "actions": { "source": { "organizeImports": "off" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      // The imported code uses non-null assertions on purpose (rows known to exist); not a defect.
      "style": { "noNonNullAssertion": "off" },
      // Findings already present in the imported code are warnings until the module that owns them is
      // reworked (listed in docs/acceptance/2026-10-02-M0-baseline.md); new code must not add more.
      "correctness": { "noPrecisionLoss": "warn", "useExhaustiveDependencies": "warn", "useJsxKeyInIterable": "warn" },
      "suspicious": {
        "noArrayIndexKey": "warn",
        "noControlCharactersInRegex": "warn",
        "useIterableCallbackReturn": "warn",
        "noAssignInExpressions": "warn",
        "noImplicitAnyLet": "warn"
      },
      "security": { "noDangerouslySetInnerHtml": "warn" },
      "a11y": {
        "noSvgWithoutTitle": "warn",
        "useAriaPropsSupportedByRole": "warn",
        "useSemanticElements": "warn",
        "noAriaHiddenOnFocusable": "warn",
        "noStaticElementInteractions": "warn",
        "useKeyWithClickEvents": "warn",
        "useFocusableInteractive": "warn",
        "noNoninteractiveTabindex": "warn",
        "useButtonType": "warn",
        "noAutofocus": "warn"
      }
    }
  }
}
