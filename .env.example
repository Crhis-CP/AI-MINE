# AI矿策 的配置。复制成 .env 再改（或者运行 node scripts/init-env.ts，它会生成 .env 并填好随机密钥）。
# 前端只拿到网站地址；所有密钥只在后端。不要把 .env 提交到 Git。

# ===== 必填 =====

# 网站对外的地址：生成的链接、RSS、分享图、MCP 都用它。本机试用就用下面这个。
SITE_URL=http://localhost:3000

# 管理员密码（至少 12 位），登录 /admin 用。
ADMIN_PASSWORD=

# 私有API会话签名密钥（生产必需）；图片代理仍关闭，IMG密钥不再是API启动必需项。
SESSION_SECRET=
IMG_PROXY_SIGN_SECRET=

# 公开API反馈限流的独立密钥，生产必需；不能由 SESSION_SECRET 代替。
PUBLIC_RATE_LIMIT_SECRET=

# 后台模型密钥的加密主密钥；init-env 和正式发布首次准备，后续必须保留原值。
MODEL_REGISTRY_ENCRYPTION_KEY=

# 用 Docker 时数据库的密码（数据库不对外开放端口，也请用随机字符）。
POSTGRES_PASSWORD=

# 模型：任何 OpenAI 兼容接口都可以，所有步骤默认都用它。下面是 DeepSeek 的写法。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# 服务商特有的请求参数（JSON），比如关掉思考模式：
LLM_EXTRA_JSON={"thinking":{"type":"disabled"}}
# 其他服务商的例子：
#   千问      LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen3.8-flash  LLM_EXTRA_JSON={"enable_thinking":false}
#   智谱      LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4               LLM_MODEL=glm-5.3-flash
# 模型能看图就打开（精选内容的标题摘要会参考首图）：
# LLM_VISION=true
# 服务不支持 JSON 模式（response_format）时关掉：
# LLM_JSON_MODE=false

# ===== 选填：让事件归组更准 =====

# 向量召回：任何 OpenAI 兼容的 /embeddings 接口。不填也能跑，只是归组少一路线索。
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# 或者只填阿里云百炼的 key，就用 text-embedding-v4：
# DASHSCOPE_API_KEY=

# ===== 选填：每一步单独换模型 =====
# 默认每一步都用上面的 LLM_*。想让某一步用别家，填预设名（需要对应的 key）：
#   PREFILTER_MODEL  SCORE_MODEL  UNDERSTAND_MODEL  SUMMARIZE_MODEL  WORDING_MODEL  STRUCTURE_MODEL
#   GROUP_MODEL  GROUP_REVIEW_MODEL  DIGEST_MODEL  REPORT_MODEL  TRANSLATE_MODEL
# 预设名与需要的 key：
#   deepseek-flash / deepseek-flash-think        DEEPSEEK_BASE_URL=https://api.deepseek.com/v1  DEEPSEEK_API_KEY=
#   qwen3.7-flash / qwen3.8-flash / qwen3-vl-flash  DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  DASHSCOPE_API_KEY=
#   glm-5.3-flash / glm-5.3-flash-selection     ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4  ZHIPU_API_KEY=
#   mimo-v2.6-flash                             XIAOMI_MIMO_BASE_URL=https://api.xiaomimimo.com/v1  XIAOMI_MIMO_API_KEY=
# 上游基础方案 四个位置原来各用哪个预设（保持注释，测试阶段不要启用；各环节继续用上面的 LLM_*，同一把密钥）：
#   通义：预筛、结构抽取
#   PREFILTER_MODEL=qwen3.7-flash  STRUCTURE_MODEL=qwen3.8-flash
#   智谱：精选评分、入选稿的标题导读
#   SCORE_MODEL=glm-5.3-flash-selection  UNDERSTAND_MODEL=glm-5.3-flash
#   DeepSeek：其余稿的标题摘要、事件归组、事件综述、日报周报月报、全文翻译
#   SUMMARIZE_MODEL=deepseek-flash  GROUP_MODEL=deepseek-flash  DIGEST_MODEL=deepseek-flash
#   REPORT_MODEL=deepseek-flash  TRANSLATE_MODEL=deepseek-flash
#   小米：归组拿不准时再读一遍
#   GROUP_REVIEW_MODEL=mimo-v2.6-flash
# 法规全文、分组、解读、核验不另开一家，也用上面的 LLM_*。各位置的白话说明在后台「模型与评测」。

# ===== 选填：付费的采集服务（按请求计费，有预算熔断，在后台“设置”里调） =====
# 微信公众号：极致了（Dajiala）
# DAJIALA_KEY=
# 抓不到正文时用浏览器渲染兜底：Jina Reader
# JINA_API_KEY=
# 读 GitHub 接口类信源时提高配额（只读 token）
# GITHUB_TOKEN=

# ===== 选填：飞书 =====
# 精选推送到飞书群：在后台“用量与模型密钥”里的“通知与请求频率”启用，webhook 地址填在这里。
FEISHU_CONTENT_PUSH_ENABLED=false
# FEISHU_PUSH_WEBHOOK_URL=
# FEISHU_PUSH_MIRROR_WEBHOOK_URL=
# 运行提醒（告警、每日摘要、周报）发到飞书群，需要一个飞书自建应用；开关只认 true；群号用 `node scripts/feishu-check.ts` 列出来。
FEISHU_INTERNAL_ENABLED=false
# 完整读者反馈转发：仅worker启用；需同步披露隐私说明，使用专用私有群。
FEISHU_FEEDBACK_ENABLED=false
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_INTERNAL_CHAT_ID=  # 读者反馈专用群，不使用内容群或运行提醒群
# 提醒群号；没填时提醒改发上面的反馈群号（FEISHU_INTERNAL_CHAT_ID）
# FEISHU_ALERT_CHAT_ID=
# 用飞书账号登录后台（可选，和管理员密码并存）：
# FEISHU_LOGIN_APP_ID=
# FEISHU_LOGIN_APP_SECRET=
# ADMIN_FEISHU_UNION_IDS=
# ADMIN_EMAILS=

# ===== 选填：其他 =====
# 外部脚本往站里推送内容（POST /api/ingest/items）用的 token，至少 16 位。这个接口首版关闭、不注册，
# 填了也不生效；重新启用须 Owner 批准。
# INGEST_TOKEN=
# 抓取海外信源要走代理时（比如服务器在中国大陆）。不填就直连。
# 填了以后，抓信源和图片走这个地址，调用模型不走。仓库不提供这个代理程序。
# EGRESS_PROXY_URL=http://127.0.0.1:7890
# 前面有 Caddy 或 Nginx 这类反向代理时设为 true，访客地址才从代理的 X-Forwarded-For 里读；
# 网站直接对外时保持 false，免得有人伪造地址绕过登录次数和反馈的限制。
TRUST_PROXY=false
# MCP 只接受发给 SITE_URL 域名（和 localhost）的请求；还有别的访问域名时，逗号分隔写在这里：
# MCP_ALLOWED_HOSTS=
# 网站多久没有新内容就算“停止收录”并告警（分钟，默认 360）：
# ALERT_QUIET_MINUTES=360
# 每天把新页面提交给 IndexNow（Bing 等）；key 是 32 位十六进制，自己生成一个：
INDEXNOW_SUBMIT_ENABLED=false
# INDEXNOW_KEY=
# 数据库每天备份到 S3 兼容的对象存储（腾讯云 COS、AWS S3、阿里云 OSS……）：
# 没有对象存储时，可显式启用每日同盘备份；仅保留最近一次有效本地副本，不替代异地灾备。
# 发布恢复点另行保留，本项不清理它们。空间不足时保留旧备份并报告失败。
DB_BACKUP_LOCAL_ENABLED=false
# DB_BACKUP_STORE_SECRET_ID=
# DB_BACKUP_STORE_SECRET_KEY=
# DB_BACKUP_STORE_BUCKET=
# DB_BACKUP_STORE_REGION=
# DB_BACKUP_STORE_DOMAIN=

# ===== 安全阀 =====
# 关掉就不抓信源、不调模型（调试界面时有用）。
COLLECT_ENABLED=true
# 分线采集独立开关；不影响处理和已公开内容。关闭某线后其排队任务保留。
COLLECT_NEWS_ENABLED=true
COLLECT_POLICY_ENABLED=true
# 资讯沿用 FETCH_CONCURRENCY（默认 8）；法规独立保留 2 个领取位置，可分别调整。
# FETCH_NEWS_CONCURRENCY=8
# FETCH_POLICY_CONCURRENCY=2
MODEL_CALLS_ENABLED=true

# ===== 精选评分的 Owner 确认 =====
# 正式站（NODE_ENV=production）只有这里写的版本等于当前评分提示词的版本时才打分、才有精选；
# 不写或写错时不打分、不显示分数，文章照常进全部矿业动态。版本形如 selection-score@0123456789，
# 由开发方在 Owner 书面确认这一版评分标准后填写；评分提示词或门槛再改，须重新确认。
# SELECTION_CONFIRMED_VERSION=

# ===== 不用 Docker、直接在本机跑时才需要 =====
# DATABASE_URL=postgres://用户名@127.0.0.1:5432/amp
# TASK-0004: 组合根接入 @amp/backend/db 后，按进程仅传入所需角色的地址。
# public-api: DATABASE_URL_PUBLIC_READ、DATABASE_URL_FEEDBACK_WRITE
# api（统一入口）/private-api（过渡）: DATABASE_URL_PRIVATE_OPS、DATABASE_URL_AUTH
# worker: DATABASE_URL_WORKER、DATABASE_URL_BACKUP（仅给 pg_dump）
# migrate: DATABASE_URL_MIGRATE；web不传数据库地址。
# 全部角色地址未配置时才回退到 DATABASE_URL；部分配置会失败，不混用。
# API_BASE_URL=http://127.0.0.1:3001
# 统一API地址同时服务公开与后台请求；web不持有数据库或模型凭据。
# 开发时免登录进后台（生产环境会拒绝启动）：
# DEV_AUTH_ROLE=admin

# ===== 用 docker compose --profile https 时 =====
# SITE_DOMAIN=example.com

# API_ROLE 由每个启动命令/Compose服务分别指定，不在共用.env中固定。
# api统一使用3001，同时需要PUBLIC_RATE_LIMIT_SECRET和后台登录配置。
# web与api使用同一个PRIVATE_HOST，生产填主域名（后台在/admin，ADR-0026）。
# 本机默认private.localhost，后台在http://private.localhost:3000/admin。
PRIVATE_HOST=private.localhost

# Optional bounded Cochilco overseas relay; signing file is mounted only in worker.
METAL_PRICE_RELAY_URL=
METAL_PRICE_RELAY_KEY_FILE=/run/price-relay/signing.pem
